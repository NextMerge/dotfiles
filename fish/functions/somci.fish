    echo "  🔨 Stage 4/5: Building..."
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    echo ""
    pnpm --filter sombra run build
    if test $status -ne 0

// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "cli_default_open_behavior": "new_window",
  "lsp": {
    "vtsls": {
      "settings": {
        "typescript": {
          "updateImportsOnFileMove": {
            "enabled": "always"
          }
        },
        "javascript": {
          "updateImportsOnFileMove": {
            "enabled": "always"
          }
        }
      },
      "enable_lsp_tasks": true
    },
    "oxlint": {
      "initialization_options": {
        "settings": {
          "run": "onType",
          "fixKind": "safe_fix",
          "unusedDisableDirectives": "deny"
        }
      }
    }
  },
  "edit_predictions": {
    "provider": "mercury"
  },
  "agent_servers": {
    "cursor": {
      "favorite_config_option_values": {
        "model": ["composer-2[fast=true]", "claude-opus-4-7[thinking=true,context=300k,effort=xhigh]"]
      },
      "type": "registry"
    },
    "opencode": {
      "favorite_config_option_values": {
        "model": ["opencode/kimi-k2.6", "opencode/big-pickle"]
      },
      "favorite_models": ["opencode/kimi-k2.5", "opencode/kimi-k2.5-free"],
      "type": "registry"
    }
  },
  "debugger": {
    "button": false
  },
  "search": {
    "button": false
  },
  "status_bar": {
    "cursor_position_button": false
  },
  "project_panel": {
    "button": false
  },
  "which_key": {
    "delay_ms": 100,
    "enabled": true
  },
  "indent_guides": {
    "background_coloring": "disabled",
    "coloring": "indent_aware"
  },
  "colorize_brackets": true,
  "tab_size": 2,
  "sticky_scroll": {
    "enabled": true
  },
  "agent": {
    "use_modifier_to_send": true,
    "default_model": {
      "provider": "copilot_chat",
      "model": "gpt-5-mini"
    },
    "model_parameters": []
  },
  "theme": "Catppuccin Mocha (red) - No Italics",
  "icon_theme": "Catppuccin Mocha",
  "vim_mode": true,
  "relative_line_numbers": "enabled",
  "ui_font_size": 16,
  "buffer_font_features": {
    "calt": false
  },
  "buffer_font_size": 18,
  "autosave": {
    "after_delay": {
      "milliseconds": 1000
    }
  },
  "tabs": {
    "git_status": false,
    "file_icons": true
  },
  "terminal": {
    "button": false,
    "font_family": "JetBrainsMono Nerd Font",
    "shell": {
      "program": "/opt/homebrew/bin/fish"
    },
    "copy_on_select": true,
    "option_as_meta": true
  },
  "git": {
    "inline_blame": {
      "enabled": false
    }
  },
  "scrollbar": {
    "axes": {
      "horizontal": false,
      "vertical": false
    }
  },
  "tab_bar": {
    "show_tab_bar_buttons": true,
    "show_pinned_tabs_in_separate_row": true,
    "show": false
  },
  "file_types": {
    "Shell Script": [".env-sample"]
  },
  "languages": {
    "JavaScript": {
      // "language_servers": ["tsgo", "!vtsls", "!typescript-language-server", "oxlint", "oxfmt"],
      "formatter": [{ "language_server": { "name": "oxfmt" } }]
    },
    "TypeScript": {
      // "language_servers": ["tsgo", "!vtsls", "!typescript-language-server", "oxlint", "oxfmt"],
      "formatter": [{ "language_server": { "name": "oxfmt" } }]
    },
    "TSX": {
      // "language_servers": ["tsgo", "!vtsls", "!typescript-language-server", "tailwind-language-server", "oxlint", "oxfmt"],
      "formatter": [{ "language_server": { "name": "oxfmt" } }]
    },
    "JSON": { "formatter": [{ "language_server": { "name": "oxfmt" } }] },
    "JSONC": { "formatter": [{ "language_server": { "name": "oxfmt" } }] },
    "CSS": { "formatter": [{ "language_server": { "name": "oxfmt" } }] },
    "GraphQL": { "formatter": [{ "language_server": { "name": "oxfmt" } }] },
    "Fish": {
      "formatter": [
        {
          "external": {
            "command": "fish_indent"
          }
        }
      ]
    }
  },
  "command_aliases": {
    "rl": "editor::RestartLanguageServer",
    "kv": "vim::OpenDefaultKeymap",
    "kd": "dev::OpenKeyContextView",
    "pt": "pane::TogglePinTab"
  }
}
